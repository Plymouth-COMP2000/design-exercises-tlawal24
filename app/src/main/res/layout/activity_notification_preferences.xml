<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification Preferences"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <CheckBox
        android:id="@+id/bookingNotifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Booking Notifications"/>

    <CheckBox
        android:id="@+id/cancellationNotifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancellation Notifications"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/savePreferencesBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Preferences"
        android:layout_marginTop="24dp"/>

</LinearLayout>
